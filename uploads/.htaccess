# Segurança extra: mesmo que alguém consiga colocar um arquivo malicioso
# aqui dentro, o servidor nunca executa ele como PHP — só serve como arquivo
# estático (imagem, texto, etc).

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

AddHandler cgi-script .php .php3 .php4 .php5 .php7 .php8 .phtml .pl .py .jsp .asp .sh .cgi
Options -ExecCGI -Indexes
